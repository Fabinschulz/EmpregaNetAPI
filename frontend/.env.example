# Variáveis NEXT_PUBLIC_* são expostas ao navegador; nunca coloque segredo aqui.
NEXT_PUBLIC_API_BASE_URL=http://localhost:5225
# Opcional. Client ID do Google Sign-In; vazio esconde o botão de login com Google.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# NEXT_PUBLIC_ALLOWED_ORIGINS=http://localhost:3000

# Opcional. URL INTERNA que o processo Next (server-side) usa para alcançar a API
# em produção (rede de containers/k8s). Sem valor, o SSR reusa NEXT_PUBLIC_API_BASE_URL.
# API_INTERNAL_BASE_URL=http://api:8080
